# ── Basics ───────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://okfinal.cz

# ── Admin (to be filled) ─────────────────────────────────────────
# Prostý heslový login do /admin. Vygeneruj něco silného.
ADMIN_PASSWORD=
# HMAC secret pro JWT session cookie. `openssl rand -hex 32`
ADMIN_JWT_SECRET=

# ── Convex ───────────────────────────────────────────────────────
# Založ projekt na dashboard.convex.dev, `npx convex dev` doplní zbytek.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOY_KEY=

# ── Resend (transakční e-mail) ───────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=noreply@okfinal.cz
RESEND_TO_INQUIRIES=info@okfinal.cz

# ── Cloudflare Turnstile (anti-spam) ─────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
